# ============================================================================
# Observability Stack Configuration
#
# IMPORTANT: Copy this file to .env and fill in your own values before
# running `docker compose up`. The .env file is in .gitignore to prevent
# accidental commits of your secrets.
#
# This template includes all available configuration options. Remove or
# comment out options you don't need.
# ============================================================================

# =============================================================================
# GRAFANA — Required
# =============================================================================

# Grafana admin user (you can change this after first login)
GRAFANA_ADMIN_USER=admin

# STRONG password for Grafana admin user
# Generate a strong password: $(openssl rand -base64 16)
# REQUIRED - do not leave as "changeme"
GRAFANA_ADMIN_PASSWORD=changeme

# Grafana domain (used in Grafana config and email alerts)
# Set to localhost for local testing, your domain name for production
# Examples: localhost, 192.168.1.100, grafana.example.com
GRAFANA_DOMAIN=localhost

# =============================================================================
# GRAFANA SMTP — Optional (only used if GRAFANA_SMTP_ENABLED=true)
# =============================================================================

# Enable email notifications from Grafana
# Set to "true" to send alert notifications via email
# Requires SMTP_* variables below
GRAFANA_SMTP_ENABLED=false

# SMTP server hostname and port (typically 587 for TLS or 25 for plaintext)
# Examples: smtp.gmail.com:587, mail.example.com:25, smtp.office365.com:587
GRAFANA_SMTP_HOST=smtp.example.com:587

# SMTP authentication username (usually email address)
GRAFANA_SMTP_USER=you@example.com

# SMTP authentication password
# For Gmail: use an App Password, not your main password
# https://support.google.com/accounts/answer/185833
GRAFANA_SMTP_PASSWORD=

# Email address that alerts will be sent from
GRAFANA_SMTP_FROM=grafana@example.com

# =============================================================================
# ALERTMANAGER — Discord Integration — Optional
# =============================================================================

# Discord webhook URL for sending alerts to a Discord channel
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook
# Example: https://discord.com/api/webhooks/1234567890/abcdefghijklmnop
# Leave as placeholder if not using Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE

# =============================================================================
# ALERTMANAGER — Email Integration — Optional
# =============================================================================

# Email address alerts will be sent from (usually a noreply@ address)
# This will appear as the "From:" in alert emails
# Example: alerts@example.com, noreply@homelab.local
SMTP_FROM=alerts@example.com

# Email address alerts will be sent to
# Can be one address or comma-separated for multiple recipients
# Example: you@example.com, admin@example.com
ALERT_EMAIL_TO=you@example.com

# SMTP server hostname and port
# Same format as GRAFANA_SMTP_HOST
# Examples: smtp.gmail.com:587, mail.example.com:25
SMTP_HOST=smtp.example.com

# SMTP authentication username
SMTP_USER=you@example.com

# SMTP authentication password
SMTP_PASSWORD=

# =============================================================================
# ADDITIONAL NOTES
# =============================================================================

# To use Discord alerts:
#   1. Create Discord server and channel
#   2. Create webhook: https://discord.com/developers/docs/resources/webhook
#   3. Set DISCORD_WEBHOOK_URL to webhook URL
#   4. Note: May need to restart alertmanager container after setting webhook
#
# To use Email alerts:
#   1. Configure SMTP server details above
#   2. For Gmail: Enable 2FA and create App Password
#   3. You can use either Gmail or your own SMTP server
#   4. Test SMTP config when troubleshooting
#
# Passwords and secrets:
#   - Never commit .env to git (it's in .gitignore)
#   - Rotate passwords periodically
#   - Use strong, unique passwords (16+ characters)
#   - For production, consider using Docker secrets instead of .env
